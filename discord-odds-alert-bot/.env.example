# KashRock API key — get one at https://www.kashrock.com/console
# Sandbox (free) works for CS2 props; see README.md for plan requirements.
KASHROCK_API_KEY=kr_live_your_key_here

# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Channel ID where alerts are posted (right-click channel > Copy Channel ID,
# with Discord developer mode on). Required for scheduled posts; /odds works
# without it.
DISCORD_CHANNEL_ID=

# Optional: sync slash commands instantly to one guild instead of globally
# (global sync can take up to an hour to propagate).
DISCORD_GUILD_ID=

# --- Alert configuration (all optional) ---

# Comma-separated sports: apex, cod, cs2, deadlock, dota2, lol, mlbb, r6, valorant
KASHROCK_SPORT=cs2

# Props board: dfs (pick'em apps) | main (sportsbook named props) | all
KASHROCK_BOARD=all

# Optional filters, comma-separated:
# KASHROCK_MARKETS=kills,headshots   (matches market type/label/stat)
# KASHROCK_BOOKS=prizepicks,underdog (book keys from /v7/meta)
# KASHROCK_PLAYERS=s1mple,ZywOo     (player name substring)

# Poll interval in minutes (default 5)
POLL_INTERVAL_MINUTES=5

# Requests-per-minute budget for the client-side limiter.
# Match your plan: sandbox=10, hobby=30, builder=100, pro=250, quant=500
KASHROCK_RPM=10

# Where dedupe state lives (default: ./odds_alert_state.json next to bot.py)
# STATE_FILE=
